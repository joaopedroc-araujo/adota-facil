generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum UserRole {
  SUPERADMIN
  ONGADMIN
  VOLUNTEER
}

enum AnimalStatus {
  AVAILABLE
  ADOPTED
  UNDER_TREATMENT
  QUARANTINE
}

enum AdoptionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  OVERDUE
  CANCELLED
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  subdomain String   @unique
  config    Json?
  createdAt DateTime @default(now())

  // Relações
  animals     Animal[]
  events      Event[]
  pages       Page[]
  userTenants UserTenant[]
  features    TenantFeature[]
  adoptions   Adoption[]
  followUps   FollowUp[]
}

model Animal {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  description String
  species     String?
  breed       String?
  age         String?
  gender      String?
  healthNotes String?
  status      AnimalStatus @default(AVAILABLE)
  photos      String[]
  createdAt   DateTime     @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adoptions Adoption[]

  @@index([tenantId])
}

model Event {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  date        DateTime
  description String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Page {
  id       String @id @default(uuid())
  tenantId String
  slug     String
  content  String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  phone     String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())

  usersTenants UserTenant[]
  adoptions    Adoption[]
}

model UserTenant {
  id       String   @id @default(uuid())
  userId   String
  tenantId String
  role     UserRole

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

model TenantFeature {
  id       String  @id @default(uuid())
  tenantId String
  feature  String
  enabled  Boolean

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, feature])
}

model Adoption {
  id             String         @id @default(uuid())
  tenantId       String
  animalId       String
  adopterId      String
  status         AdoptionStatus @default(PENDING)
  notes          String?
  adoptionDate   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  animal    Animal     @relation(fields: [animalId], references: [id], onDelete: Cascade)
  adopter   User       @relation(fields: [adopterId], references: [id], onDelete: Cascade)
  followUps FollowUp[]

  @@index([tenantId])
  @@index([animalId])
  @@index([adopterId])
}

model FollowUp {
  id           String         @id @default(uuid())
  tenantId     String
  adoptionId   String
  scheduledDate DateTime
  completedDate DateTime?
  status       FollowUpStatus @default(PENDING)
  notes        String?
  label        String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adoption Adoption @relation(fields: [adoptionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([adoptionId])
  @@index([scheduledDate])
}
