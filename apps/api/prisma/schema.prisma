generator client {
  provider = "prisma-client-js"
  output   = "node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum UserRole {
  SUPERADMIN
  ONGADMIN
  VOLUNTEER
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  subdomain String   @unique
  config    Json?
  createdAt DateTime @default(now())

  // Relações
  animals     Animal[]
  events      Event[]
  pages       Page[]
  userTenants UserTenant[]
  features    TenantFeature[]
}

model Animal {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String
  photos      String[]
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Event {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  date        DateTime
  description String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Page {
  id       String @id @default(uuid())
  tenantId String
  slug     String
  content  String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  phone     String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())

  usersTenants UserTenant[]
}

model UserTenant {
  id       String   @id @default(uuid())
  userId   String
  tenantId String
  role     UserRole

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

model TenantFeature {
  id       String  @id @default(uuid())
  tenantId String
  feature  String
  enabled  Boolean

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, feature])
}
